<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Reading Portfolio</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Poppins:wght@600&display=swap" rel="stylesheet">
<style>
:root{
--bg:#fff9fb;
--surface:#ffffff;
--primary:#b9a6ff;
--mint:#aeebd6;
--peach:#ffc7b2;
--text:#2b2430;
--text2:#5e5563;
--border:#eadde7;
}

body{
margin:0;
font-family:Inter;
background:var(--bg);
color:var(--text);
}

nav{
padding:1rem;
display:flex;
justify-content:space-between;
border-bottom:1px solid var(--border);
}

.container{
padding:2rem;
max-width:1000px;
margin:auto;
}

h1,h2{
font-family:Poppins;
}

.book-grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
gap:1rem;
}

.book-card{
background:white;
padding:1rem;
border-radius:16px;
border:1px solid var(--border);
}

.book-cover{
height:150px;
display:flex;
align-items:center;
justify-content:center;
border-radius:12px;
margin-bottom:0.5rem;
}

.cover1{background:var(--primary);} 
.cover2{background:var(--mint);} 
.cover3{background:var(--peach);} 

button{
background:var(--primary);
border:none;
padding:0.5rem 1rem;
border-radius:20px;
cursor:pointer;
}

.search-form{
display:flex;
gap:0.5rem;
margin-bottom:1rem;
}

input{
padding:0.5rem;
flex:1;
border-radius:20px;
border:1px solid var(--border);
}

.api-cover{
width:100%;
height:180px;
object-fit:contain;
}
</style>
</head>

<body>

<nav>
<h2>Reading Portfolio</h2>
</nav>

<div class="container">

<h1>My Books</h1>

<div class="book-grid">

<div class="book-card">
<div class="book-cover cover1">The Hate U Give</div>
<h3>The Hate U Give</h3>
<p>★★★★★</p>
</div>

<div class="book-card">
<div class="book-cover cover2">The Midnight Library</div>
<h3>The Midnight Library</h3>
<p>★★★★☆</p>
</div>

<div class="book-card">
<div class="book-cover cover3">Atomic Habits</div>
<h3>Atomic Habits</h3>
<p>Want to Read</p>
</div>

</div>

<h2>Search for Books</h2>

<form id="searchForm" class="search-form">
<input id="searchInput" placeholder="Search books...">
<button type="submit">Search</button>
</form>

<div id="results" class="book-grid"></div>

</div>

<script>
const form=document.getElementById("searchForm");
const input=document.getElementById("searchInput");
const results=document.getElementById("results");

form.addEventListener("submit",async(e)=>{
e.preventDefault();

const query=input.value;
if(query==="")return;

results.innerHTML="Searching...";

const res=await fetch(`https://www.googleapis.com/books/v1/volumes?q=${query}`);
const data=await res.json();

results.innerHTML="";

if(!data.items){
results.innerHTML="No results";
return;
}

data.items.slice(0,6).forEach(book=>{
const info=book.volumeInfo;

const title=info.title||"No title";
const author=info.authors?info.authors.join(", "):"Unknown";
const img=info.imageLinks?info.imageLinks.thumbnail:"";

const card=document.createElement("div");
card.className="book-card";

card.innerHTML=`
${img?`<img src="${img}" class="api-cover">`:`<div class="book-cover cover1">No Cover</div>`}
<h3>${title}</h3>
<p>${author}</p>
`;

results.appendChild(card);
});
});
</script>

</body>
</html>
